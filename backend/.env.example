# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- MongoDB ----------
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/college_events
# MongoDB Atlas (replace user, password and cluster):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/college_events?retryWrites=true&w=majority

# ---------- JWT ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET= a87817dc5e38d32c3a263ca6e9d6846de33c66710942611373bc85dc72867e1c8ceeb915529cd5db175d52f38cfab21d904a3604a09967066ce9b5e487d834c5
JWT_EXPIRES_IN=7d

# ---------- CORS ----------
# The URL of the React app (comma-separate several if needed)
CLIENT_URL=http://localhost:5173

# ---------- First admin (used ONLY by `npm run seed:admin`) ----------
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=ChangeThisPassword123!
